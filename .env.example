# Copia este archivo como .env y reemplaza los valores solo en tu entorno local.
# No versiones credenciales reales.
DATABASE_URL=postgresql+psycopg://emotv:change-me@localhost:5432/emotv
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Chatbot Emi: workflow EMI publicado en n8n Cloud (n8n llama a Groq).
# La clave es la de la credencial Header Auth (cabecera X-EMOtv-Key) del webhook.
# Obligatoria para usar el chat; nunca la escribas en archivos versionados:
# quien la tenga puede gastar la cuota de Groq. Sin clave, POST /chat responde 503.
N8N_WEBHOOK_URL=https://emotv.app.n8n.cloud/webhook/emi-chat
N8N_WEBHOOK_KEY=
N8N_TIMEOUT_SECONDS=30
# Opcionales (valores por defecto): historial enviado, retención y límites por usuario.
# CHAT_HISTORY_MESSAGES=10
# CHAT_RETENTION_DAYS=90
# CHAT_LIMIT_WINDOW_MESSAGES=20
# CHAT_LIMIT_WINDOW_MINUTES=10
# CHAT_LIMIT_DAILY_MESSAGES=200
# CHAT_MAX_QUESTION_CHARS=1000
# CHAT_RISK_MESSAGE=
# Solo en redes que interceptan HTTPS: CA adicional para llamar a n8n.
# SSL_CERT_FILE=

# En producción: HTTPS, dominios reales, secreto aleatorio y base configurada.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# development: omite la exigencia para pruebas técnicas (nunca personas reales).
# demo: política provisional activa; aceptación y revocación funcionan.
# production: exige política institucional aprobada y aceptación vigente.
CONSENT_MODE=demo

# Límite de intentos de inicio de sesión (fallos dentro de la ventana).
# Al superarlo, POST /auth/token responde 429 con un mensaje genérico.
# El contador de correo+IP se reinicia con un acceso correcto; el de IP no.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_ATTEMPT_WINDOW_MINUTES=15
# Cuentas de voluntarios PRUEBA-NN: días antes de que
# scripts/testdata/delete_test_data.py --expired las elimine (1-30; el
# consentimiento en papel promete como máximo 30).
TEST_DATA_RETENTION_DAYS=30
# Análisis en vivo: el estudiante solo puede registrar una expresión si hay
# rostro, la expresión estabilizada lleva LIVE_STABLE_SECONDS sin cambiar
# (0-30) y su confianza media es al menos LIVE_MIN_CONFIDENCE (0-1).
LIVE_STABLE_SECONDS=1
LIVE_MIN_CONFIDENCE=0.5
# Admisión facial: límites iniciales operativos, ajustar tras medir el pipeline.
EMOTION_WARN_LATENCY_MS=250
EMOTION_BLOCK_LATENCY_MS=1000
EMOTION_WARN_CPU_PERCENT=75
EMOTION_BLOCK_CPU_PERCENT=95
EMOTION_RESERVE_RAM_MIB=512
EMOTION_RAM_SAFETY_FACTOR=1.5
EMOTION_BENCHMARK_MAX_AGE_DAYS=30
# Rutas opcionales de informes generados EN el servidor (absolutas o desde su cwd).
# FERPLUS_BENCHMARK_PATH=reports/benchmarks/ferplus-baseline.json
# HARDLYHUMANS_BENCHMARK_PATH=reports/benchmarks/hardlyhumans-check-01.json
