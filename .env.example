# Copia este archivo como .env y reemplaza los valores solo en tu entorno local.
# No versiones credenciales reales.
DATABASE_URL=postgresql+psycopg://emotv:change-me@localhost:5432/emotv
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# En producción: HTTPS, dominios reales, secreto aleatorio y base configurada.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
