# Configuración de EMOtv para Docker Compose.
# No edites este ejemplo con valores reales: genera tu copia con
#   python scripts/docker/init_env.py
# (o con Docker, ver docs/docker.md). La copia .env.docker no se versiona.

# --- PostgreSQL (servicio db) ---
# La contraseña solo se aplica la primera vez que se crea el volumen emotv_pgdata.
POSTGRES_USER=emotv
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=emotv
# Puerto del host para el modo "solo base de datos" (docker-compose.db.yml).
POSTGRES_HOST_PORT=5433

# URL que usa la API dentro de la red de Docker (el host es el servicio "db").
# Se construye a partir de las variables anteriores; usa solo caracteres
# seguros para URL en la contraseña (init_env.py ya lo hace).
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- Autenticación ---
# Al menos 32 caracteres aleatorios. init_env.py lo genera.
JWT_SECRET_KEY=__GENERATE__

# --- Entorno ---
# Valores aceptados por la API: development, test o production.
# Para demostraciones usa development con CONSENT_MODE=demo.
# production exige HTTPS en CORS_ORIGINS (perfil https) y CONSENT_MODE=production.
ENVIRONMENT=development
# Consentimiento. Valor para pruebas funcionales y presentación: demo.
# demo: pruebas con voluntarios (con consentimiento firmado en papel) y la
#   presentación. Activa la política de prueba v0.2 (docs/consent-demo.md);
#   cada cuenta debe aceptarla antes de analizar y puede revocarla.
# development: solo pruebas técnicas del desarrollador, sin otras personas.
#   No exige consentimiento para analizar. Nunca con voluntarios.
# production: uso institucional real. Exige ENVIRONMENT=production y una
#   política aprobada por la institución; rechaza políticas de prueba.
CONSENT_MODE=demo

# Límite de intentos de inicio de sesión (fallos dentro de la ventana).
# Al superarlo, POST /auth/token responde 429 con un mensaje genérico.
# El contador de correo+IP se reinicia con un acceso correcto; el de IP no.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_ATTEMPT_WINDOW_MINUTES=15
# Análisis en vivo: el estudiante solo puede registrar una expresión si hay
# rostro, la expresión estabilizada lleva LIVE_STABLE_SECONDS sin cambiar
# (0-30) y su confianza media es al menos LIVE_MIN_CONFIDENCE (0-1).
LIVE_STABLE_SECONDS=1
LIVE_MIN_CONFIDENCE=0.5
# Calibración neutral opcional (en memoria): aumento mínimo respecto a la base
# (0-1; 0.10 = 10 puntos) para sugerir una expresión. No cambia el registro.
LIVE_CALIBRATION_MIN_INCREASE=0.10
# Práctica de expresiones (docs/expression-practice.md): nivel suavizado de la
# expresión pedida. Se alcanza en PRACTICE_THRESHOLD (0.05-1) y se pierde bajo
# PRACTICE_RELEASE_THRESHOLD (0-1, menor que el umbral); constante de tiempo
# PRACTICE_SMOOTHING_SECONDS (0-10) y pausa tras lograrla
# PRACTICE_SUCCESS_PAUSE_SECONDS (0-10).
PRACTICE_THRESHOLD=0.6
PRACTICE_RELEASE_THRESHOLD=0.55
PRACTICE_SMOOTHING_SECONDS=0.8
PRACTICE_SUCCESS_PAUSE_SECONDS=2
# Protección de carga. API_CPUS y API_MEMORY_LIMIT limitan el contenedor api;
# MAX_CONCURRENT_ANALYSES debe ser API_CPUS - 1 (mínimo 1).
API_CPUS=3
API_MEMORY_LIMIT=2560m
MAX_CONCURRENT_ANALYSES=2
MAX_ACTIVE_SESSIONS=4
ANALYSIS_BUSY_WAIT_SECONDS=5
LIVE_IDLE_TIMEOUT_SECONDS=60
ONNX_THREADS_PER_SESSION=1
# En Docker Desktop todas las conexiones llegan con la misma IP interna, así
# que el límite por IP actúa como límite global: súbelo si bloquea a usuarios.

# --- Orígenes y hosts permitidos ---
# CORS_ORIGINS también decide qué páginas pueden abrir el WebSocket de análisis.
# Agrega https://<IP-de-esta-PC>:8443 si usas el perfil https en la red local.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Nombres de host sin puerto. Incluye la IP de esta PC si usas la red local.
TRUSTED_HOSTS=localhost,127.0.0.1,api
# IP o nombre de esta PC en la red local para el certificado del perfil https.
EMOTV_LAN_HOST=localhost

# --- Cuentas de prueba ---
# Hosts de base de datos en los que scripts/create_demo_role_accounts.py y
# scripts/testdata/ pueden crear o eliminar cuentas.
ALLOWED_ADMIN_RESET_HOSTS=db
# Días que se conservan las cuentas de voluntarios PRUEBA-NN antes de que
# scripts/testdata/delete_test_data.py --expired las elimine (1-30; el
# consentimiento en papel promete como máximo 30).
TEST_DATA_RETENTION_DAYS=30

# --- Chatbot Emi (Sim o n8n) ---
# Chatbot Emi. CHAT_PROVIDER elige el workflow: sim (vigente, sim.ai) o n8n (anterior).
# Sim: URL de ejecución del workflow desplegado como API
# (https://www.sim.ai/api/v2/workflows/<id>/execute) y clave de API de Sim (cabecera X-API-Key).
# Obligatorias para usar el chat; nunca escribas la clave en archivos versionados:
# quien la tenga puede gastar la cuota del workflow. Sin ellas, POST /chat responde 503.
CHAT_PROVIDER=sim
SIM_WORKFLOW_URL=
SIM_API_KEY=
CHAT_TIMEOUT_SECONDS=30
# Solo con CHAT_PROVIDER=n8n: webhook del workflow EMI en n8n Cloud y la clave de su
# credencial Header Auth (cabecera X-EMOtv-Key).
N8N_WEBHOOK_URL=https://emotv.app.n8n.cloud/webhook/emi-chat
N8N_WEBHOOK_KEY=
# Opcionales (valores por defecto): historial enviado, retención y límites por usuario.
# CHAT_HISTORY_MESSAGES=10
# CHAT_RETENTION_DAYS=90
# CHAT_LIMIT_WINDOW_MESSAGES=20
# CHAT_LIMIT_WINDOW_MINUTES=10
# CHAT_LIMIT_DAILY_MESSAGES=200
# CHAT_MAX_QUESTION_CHARS=1000
# CHAT_RISK_MESSAGE=
# HTTPS hacia el workflow de Emi: la API usa por defecto el almacén de CA de la imagen, que
# incluye las CA de docker/certs/ (redes que interceptan HTTPS).
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# --- Privacidad (docs/privacy/) ---
# Clave Fernet para cifrar notas, respuestas, comentarios y reportes. Varias
# claves separadas por comas: la primera cifra y todas descifran (rotación).
# Vacía: las sesiones con protocolo no se activan. Nunca la subas al
# repositorio. Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SENSITIVE_DATA_KEY=
# Cuentas de administrador activas a la vez y retención (meses; las sesiones se
# eliminan con todos sus registros al vencer).
MAX_ADMIN_ACCOUNTS=1
SESSION_RETENTION_MONTHS=12
AUDIT_RETENTION_MONTHS=24

# Aplicativo Android: versión mínima aceptada (x.y.z). Contrato: docs/mobile-api.md.
MOBILE_MIN_APP_VERSION=1.0.0
# Clave Fernet DISTINTA de SENSITIVE_DATA_KEY para cifrar los respaldos de
# scripts/docker/backup_db.py. La usan solo los scripts del anfitrión; no se
# pasa a la API.
BACKUP_KEY=
