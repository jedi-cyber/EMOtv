# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
# Directorio temporal de pytest (--basetemp); contiene repos Git de prueba.
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Packaging and build artifacts
build/
dist/
*.egg-info/
*.egg

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.docker.example
.env.docker
*.pem
*.key

# Editors and operating systems
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini

# Jupyter
.ipynb_checkpoints/

# Logs and temporary files
*.log
*.tmp
*.temp
~$*

# Local datasets (keep documentation/placeholders)
data/raw/**
data/interim/**
data/processed/**
data/external/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Model weights and generated artifacts
*.pt
*.pth
*.onnx
*.safetensors
models/weights/hardlyhumans_vit/
*.engine
*.tflite
*.task
models/artifacts/**
!models/artifacts/.gitkeep

# Generated inference, training, and export outputs
runs/
outputs/
exports/

# Frontend dependencies and Vite output
web/node_modules/
web/dist/
web/.vite/
web/.npm-cache/
web/.env.local

*.tsbuildinfo
CLAUDE.md

# Respaldos de la base de datos (scripts/docker/backup_db.py)
backups/

# CA locales para redes con inspección HTTPS (docker/certs/README.md)
docker/certs/*.crt
docker/certs/*.cer
.claude/settings.local.json
# Informes de la evaluación de Emi: contienen respuestas para revisión humana.
reports/chatbot/
# Actas de eliminación de datos de voluntarios (delete_test_data.py --save).
reports/deletions/
DESIGN.md
# Pruebas e2e (Playwright): informes, trazas y la cámara simulada.
# Las imágenes de rostro son del desarrollador y nunca se suben.
web/test-results/
web/playwright-report/
web/blob-report/
web/e2e/fixtures/*
!web/e2e/fixtures/README.md
