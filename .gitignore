# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Packaging and build artifacts
build/
dist/
*.egg-info/
*.egg

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editors and operating systems
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini

# Jupyter
.ipynb_checkpoints/

# Logs and temporary files
*.log
*.tmp
*.temp
~$*

# Local datasets (keep documentation/placeholders)
data/raw/**
data/interim/**
data/processed/**
data/external/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Model weights and generated artifacts
*.pt
*.pth
*.onnx
*.engine
*.tflite
models/artifacts/**
!models/artifacts/.gitkeep

# Generated inference, training, and export outputs
runs/
outputs/
exports/
